#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

./scripts/setup_opencats

docker compose up -d --build --remove-orphans

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

echo "OpenCATS is starting."
echo "Web: http://localhost:${OPENCATS_HTTP_PORT:-8080}"

